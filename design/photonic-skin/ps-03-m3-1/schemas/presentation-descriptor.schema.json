{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimicry.group/schemas/photonic-skin/presentation-descriptor.m3-1.schema.json",
  "title": "Photonic Skin M3.1 competency presentation descriptors",
  "type": "object",
  "required": ["schemaVersion", "stage", "competencyOrder", "descriptors"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "stage": { "const": "PS-03.M3.1" },
    "competencyOrder": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "descriptors": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/descriptor" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "profileComponents": {
      "type": "object",
      "required": ["desktop", "mobile390", "silhouette180", "silhouette96"],
      "additionalProperties": false,
      "properties": {
        "desktop": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "mobile390": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "silhouette180": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "silhouette96": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "descriptor": {
      "type": "object",
      "required": [
        "competencyId",
        "singleStateRef",
        "assemblyEmblem",
        "rigidComponentGroups",
        "semanticPivot",
        "semanticUp",
        "semanticForward",
        "canonicalEulerDegrees",
        "preferredCanonicalThreeQuarter",
        "allowedTiltDegrees",
        "allowedScale",
        "depthBudget",
        "flatness",
        "aspectRatio",
        "projectedAreaCalibration",
        "minimumProjectedFootprintPx",
        "protectedRecognizabilityFeatures",
        "profileComponents",
        "forbiddenOrientations",
        "reflectionAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "competencyId": { "type": "string" },
        "singleStateRef": { "type": "string", "pattern": "^single-" },
        "assemblyEmblem": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "rigidComponentGroups": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        },
        "semanticPivot": { "$ref": "#/$defs/vec3" },
        "semanticUp": { "$ref": "#/$defs/vec3" },
        "semanticForward": { "$ref": "#/$defs/vec3" },
        "canonicalEulerDegrees": { "$ref": "#/$defs/vec3" },
        "preferredCanonicalThreeQuarter": { "enum": ["front-left", "front-right", "balanced-front"] },
        "allowedTiltDegrees": { "$ref": "#/$defs/range" },
        "allowedScale": { "$ref": "#/$defs/range" },
        "depthBudget": { "type": "number", "exclusiveMinimum": 0 },
        "flatness": { "type": "number", "minimum": 0, "maximum": 1 },
        "aspectRatio": { "type": "number", "minimum": 1 },
        "projectedAreaCalibration": {
          "type": "object",
          "required": ["canonical", "alternate"],
          "additionalProperties": false,
          "properties": {
            "canonical": { "type": "number", "exclusiveMinimum": 0 },
            "alternate": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "minimumProjectedFootprintPx": {
          "type": "object",
          "required": ["desktop", "mobile390", "silhouette180", "silhouette96"],
          "additionalProperties": false,
          "properties": {
            "desktop": { "type": "integer", "minimum": 1 },
            "mobile390": { "type": "integer", "minimum": 1 },
            "silhouette180": { "type": "integer", "minimum": 1 },
            "silhouette96": { "type": "integer", "minimum": 1 }
          }
        },
        "protectedRecognizabilityFeatures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "profileComponents": { "$ref": "#/$defs/profileComponents" },
        "forbiddenOrientations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reflectionAllowed": { "const": false }
      }
    }
  }
}
