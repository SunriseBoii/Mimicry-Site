{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimicry.group/schemas/photonic-skin/transition-definition/1.0.0",
  "title": "PS-03.M3 TransitionDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transitionId",
    "transitionVersion",
    "fromState",
    "toState",
    "durationPolicy",
    "motionProfile",
    "primaryAxis",
    "phasePolicy",
    "componentRoutingPolicy",
    "splitMergePolicy",
    "reserveTransportPolicy",
    "continuityPolicy",
    "validationPolicy",
    "sourceStateHash",
    "targetStateHash",
    "buildConfigHash",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "transitionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "transitionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "fromState": { "type": "string" },
    "toState": { "type": "string" },
    "durationPolicy": { "type": "object" },
    "motionProfile": { "type": "string" },
    "primaryAxis": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "phasePolicy": { "type": "object" },
    "componentRoutingPolicy": { "type": "object" },
    "splitMergePolicy": { "type": "object" },
    "reserveTransportPolicy": { "type": "object" },
    "continuityPolicy": { "type": "object" },
    "validationPolicy": { "type": "object" },
    "sourceStateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetStateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "buildConfigHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": { "type": "object" }
  }
}
